ANTHROPIC_API_KEY=sk-ant-...
ALPHA_VANTAGE_KEY=your_alpha_vantage_key  # alphavantage.co — free tier, 25 req/day

# Finnhub — free tier, insider transactions + analyst recommendations
# https://finnhub.io → sign up → Dashboard → API Key
FINNHUB_KEY=

# QuiverQuant — free tier, congressional trading disclosures
# https://quiverquant.com → sign up → Account → API Key
QUIVERQUANT_KEY=

# Alpaca — paper trading keys for testing, live keys for real money
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true  # set to false when you want to trade real money

# X (Twitter) — apply at https://developer.x.com (1-3 day approval)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bluesky — sign up at https://bsky.app, then Settings → App Passwords (instant)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon — pick any instance (mastodon.social works), then Preferences → Development → New Application
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Affiliate links — auto-appended to social posts when set
ALPACA_REFERRAL_URL=
RH_REFERRAL_URL=

# ---- Health watchdog alerts (configure ANY subset; all optional) ----
# ntfy — zero-setup push. Pick a hard-to-guess topic, then subscribe in the
# ntfy app (iOS/Android) or open https://ntfy.sh/<your-topic> in a browser.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh   # override only if self-hosting ntfy
# Pushover — https://pushover.net (create an app to get a token)
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Email (SMTP) — e.g. Gmail app password
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
